# Copy to .env before running.

PORT=3001
SESSION_SECRET=change-me-before-real-use

# Required as of DASH-1 — same physical Postgres database as the bot backend
# (see dashboard/lib/db.ts's header comment: separate pool, same DB, same
# env var name as server/lib/db.ts).
DATABASE_URL=postgres://user:password@localhost:5432/vimbiso

# Used by `npm run seed` (dashboard/seed.ts) to create/update the demo
# counsellor login, and by server/__tests__/e2e/*.spec.ts as the credentials
# those Playwright specs log in with. Defaults match if left unset.
# E2E_DEMO_USERNAME=demo-counsellor
# E2E_DEMO_PASSWORD=demo-password
