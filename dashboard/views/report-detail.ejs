<%- include('partials/header') %>

  <a class="back-link" href="/dashboard">&larr; Back to Reports Queue</a>

  <h1>Report Detail</h1>
  <p class="page-subtitle">Report <code><%= reportId %></code></p>

  <% if (!report) { %>
    <div class="empty-state">
      <p><strong>Report not found</strong> — no report exists with that id.</p>
    </div>
  <% } else { %>
    <!--
      DASH-4: all 8 triage_answers (question text + answer), risk_level, and
      any sms_alerts timestamps for this report. No survivor phone number is
      shown in full — see maskPhoneNumber() in server.ts.
    -->
    <div data-testid="report-detail">
      <div class="report-detail__summary">
        <span
          class="risk-badge risk-badge--<%= (report.riskLevel || 'standard').toLowerCase() %>"
        ><%= report.riskLevel || 'Not yet scored' %></span>
        <span>Reported: <%= report.createdAtDisplay %></span>
        <% if (report.region) { %><span>Region: <%= report.region %></span><% } %>
        <span>WhatsApp: <%= report.maskedPhone %></span>
      </div>

      <h2>Triage transcript</h2>
      <% if (!report.answers || report.answers.length === 0) { %>
        <p class="page-subtitle">No triage answers recorded for this report.</p>
      <% } else { %>
        <ol class="triage-transcript">
          <% report.answers.forEach(function (a) { %>
            <li class="triage-transcript__row">
              <span class="triage-transcript__question"><%= a.questionText %></span>
              <span class="triage-transcript__answer triage-transcript__answer--<%= a.answer.toLowerCase() %>"><%= a.answer %></span>
            </li>
          <% }); %>
        </ol>
      <% } %>

      <h2>SMS alerts</h2>
      <% if (!report.smsAlerts || report.smsAlerts.length === 0) { %>
        <p class="page-subtitle">No counsellor SMS alert has been sent for this report.</p>
      <% } else { %>
        <ul class="sms-alert-list">
          <% report.smsAlerts.forEach(function (sms) { %>
            <li>
              Sent <%= sms.sentAtDisplay %><% if (sms.status) { %> — status: <%= sms.status %><% } %>
            </li>
          <% }); %>
        </ul>
      <% } %>

      <!--
        DASH-5: reply-in-channel. Lets a counsellor continue messaging the
        survivor on the same WhatsApp thread, constrained by WhatsApp's
        24-hour session window (see server.ts's computeReplyEligibility()).
      -->
      <h2>Conversation</h2>

      <% if (typeof replyFlash !== 'undefined' && replyFlash) { %>
        <div class="reply-flash reply-flash--<%= replyFlash.kind %>" role="status">
          <%= replyFlash.text %>
        </div>
      <% } %>

      <% if (!report.counsellorMessages || report.counsellorMessages.length === 0) { %>
        <p class="page-subtitle">No counsellor follow-up messages sent for this report yet.</p>
      <% } else { %>
        <ul class="counsellor-message-list">
          <% report.counsellorMessages.forEach(function (m) { %>
            <li class="counsellor-message counsellor-message--<%= m.status || 'sent' %>">
              <span class="counsellor-message__meta">
                <%= m.senderName %> · <%= m.sentAtDisplay %><% if (m.status && m.status !== 'sent') { %> · <%= m.status %><% } %>
              </span>
              <p class="counsellor-message__body"><%= m.body %></p>
            </li>
          <% }); %>
        </ul>
      <% } %>

      <% if (report.canReply) { %>
        <form class="reply-form" method="POST" action="/dashboard/reports/<%= report.id %>/reply">
          <label for="reply-body">Send a follow-up message on WhatsApp</label>
          <textarea id="reply-body" name="body" rows="3" maxlength="4096" required placeholder="Type a message to send on the same WhatsApp thread..."></textarea>
          <button type="submit">Send</button>
        </form>
      <% } else { %>
        <p class="reply-unavailable">
          <strong>Reply unavailable.</strong> <%= report.replyUnavailableReason %>
        </p>
      <% } %>
    </div>
  <% } %>

<%- include('partials/footer') %>
