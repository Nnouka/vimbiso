<%- include('partials/header') %>

  <div class="login-card">
    <h1>Counsellor log in</h1>
    <p class="page-subtitle">Vimbiso report dashboard — internal use only.</p>

    <% if (error) { %>
      <p class="form-error" role="alert"><%= error %></p>
    <% } %>

    <!--
      DASH-1: authenticates against counsellor_users (username lookup +
      bcrypt.compare against password_hash) — see server.ts's POST /login.
    -->
    <form method="POST" action="/login" novalidate>
      <div class="form-field">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" data-testid="login-username" autocomplete="username" required />
      </div>
      <div class="form-field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" data-testid="login-password" autocomplete="current-password" required />
      </div>
      <button type="submit" class="btn-primary" data-testid="login-submit">Log in</button>
    </form>
  </div>

<%- include('partials/footer') %>
