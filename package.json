{
  "name": "vimbiso",
  "version": "0.1.0",
  "description": "Vimbiso - WhatsApp-first GBV risk-triage and safety-response tool (Kenya pilot)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "migrate": "tsx server/migrations/run.ts",
    "seed": "tsx server/seeds/run_all.ts"
  },
  "type": "commonjs",
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "twilio": "^5.2.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express-session": "^1.18.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.15",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/pg": "^8.11.10",
    "@types/bcrypt": "^5.0.2",
    "@playwright/test": "^1.47.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": ["/node_modules/", "/server/__tests__/e2e/"]
  }
}
