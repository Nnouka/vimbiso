# Vimbiso — environment variables
#
# Copy this file to `.env` (already gitignored) and fill in real values.
# See docs/twilio-setup.md for how to obtain the Twilio-related values below.

# --- Twilio: WhatsApp (server/lib/whatsapp.js) ------------------------------

# Found on the Twilio Console dashboard homepage ("Account Info" panel), once
# you've created a free Twilio account. Identifies your Twilio account.
TWILIO_ACCOUNT_SID=

# Also on the Twilio Console dashboard homepage, right next to Account SID
# (click "Show" to reveal it). Treat like a password — never commit it.
TWILIO_AUTH_TOKEN=

# The WhatsApp Sandbox's own number, found in Console under Messaging > Try
# it out > Send a WhatsApp message. Format: "whatsapp:+14155238886" (Twilio's
# shared sandbox number — yours will likely be this same number in the
# sandbox, but check your own Console page).
TWILIO_WHATSAPP_FROM=

# --- Twilio: SMS (server/lib/sms.js, used by HR-2 in Sprint 2) -------------

# A Twilio phone number capable of sending SMS. For a trial account, use the
# free trial number Twilio assigns you (Console > Phone Numbers > Manage >
# Active Numbers). Plain E.164 format, no "whatsapp:" prefix, e.g. "+1234567890".
TWILIO_SMS_FROM=

# --- Database (server/migrations, server/seeds — Backend-owned) ------------

# Postgres connection string, e.g. postgres://user:password@localhost:5432/vimbiso
# Get one free from Railway/Render/Supabase, or run Postgres locally.
DATABASE_URL=

# --- Security (server/lib/hashing.js — Backend-owned, SEC-1) ---------------

# HMAC secret used to salt-hash any optional perpetrator identifier before it
# ever touches the database (Pattern Watch). Generate a long random value
# yourself, e.g. `openssl rand -hex 32` — this is not a Twilio value.
PERPETRATOR_HASH_SECRET=

# --- Alerting (server/lib/sms.js caller — Backend-owned, HR-2) -------------

# The on-call demo counsellor's phone number, in E.164 format (e.g.
# "+254712345678"). This is where the real Twilio SMS alert fires on any
# HIGH-risk report. Use a real phone you (the team) control for the demo.
ONCALL_COUNSELLOR_PHONE=

# --- Server -----------------------------------------------------------------

# Local port the Express app listens on. 3000 matches the ngrok tunnel target
# used in docs/twilio-setup.md for local development.
PORT=3000
